# =========================================================================
# פרודקשן — srv2.bizzstudio.co.il, החנות יושבת בתת-תיקייה /sweet-store.
# Next טוען את הקובץ הזה אוטומטית ב-`next build` וב-`next start`
# (NODE_ENV=production). קובץ ‎.env נשאר לפיתוח בלבד.
#
# כל משתנה NEXT_PUBLIC_* נצרב ל-bundle בזמן ה-build וגלוי לכל גולש בדפדפן —
# אין להכניס לכאן סודות. שינוי של כל ערך כאן מחייב `npm run build` מחדש.
# =========================================================================

# ---- תת-הנתיב שממנו החנות מוגשת ----
# חייב להתאים ל-ProxyPass ב-Apache. "" (ריק) = דומיין ייעודי בשורש.
# ראה src/utils/basePath.js — Next לא מוסיף אותו ל-<img>, ל-url() ב-CSS ול-manifest.
NEXT_PUBLIC_BASE_PATH=/sweet-store

# ---- ה-API של הבקאנד ----
# הכתובת הציבורית: זו שהדפדפן פונה אליה.
NEXT_PUBLIC_API_BASE_URL=https://srv2.bizzstudio.co.il/sweet-backend/api

# קריאות ה-SSR רצות על השרת עצמו ולכן פונות ישירות ל-Node, בלי לצאת ל-Apache
# ובחזרה. חוסך latency ומונע כשל רינדור אם ה-proxy החיצוני לא זמין בזמן build.
# הפורט תואם ל-PORT ב-.env של sweet-backend.
INTERNAL_API_BASE_URL=http://127.0.0.1:3050/api

# ---- כתובות החנות ----
# useAsync מפנה לכאן בעת ניתוק סשן — חייב לכלול את תת-הנתיב, אחרת הלקוח
# נזרק לשורש srv2 שאינו החנות. ללא "/" בסוף.
NEXT_PUBLIC_STORE_DOMAIN=https://srv2.bizzstudio.co.il/sweet-store
NEXT_PUBLIC_SITE_URL=https://srv2.bizzstudio.co.il/sweet-store

# socket.io — אין כרגע שרת socket מאותחל בבקאנד. נשמר לעתיד, תואם לאדמין.
NEXT_PUBLIC_API_SOCKET_URL=https://srv2.bizzstudio.co.il

# ---- התחברות Google ----
# ה-client id הציבורי של הפרויקט (התאמה ל-CLIENT_ID ב-.env של sweet-backend).
# חשוב: ב-Google Cloud Console חייב להופיע https://srv2.bizzstudio.co.il
# תחת Authorized JavaScript origins, אחרת כפתור ההתחברות ייכשל.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=219154075172-tip82u1tevjifpburic320kr9o1ecvug.apps.googleusercontent.com

# =========================================================================
# ⚠️ הערכים שמתחת הועתקו מפרויקט tmarim-betomer ולא אומתו למתוקים של בני.
# כל עוד הם כאן — הנתונים זורמים לחשבונות של הלקוח האחר.
# הושארו ריקים בכוונה: הקוד מדלג על כל בלוק שהמשתנה שלו ריק (ראה _app.js).
# למלא כשיתקבלו המזהים הנכונים, ואז לבנות מחדש.
# =========================================================================

# מספר הוואטסאפ של שירות הלקוחות (כפתור צף + אזהרת אזור משלוח)
NEXT_PUBLIC_CUSTOMER_SERVICE=

# Flashy — דיוור
NEXT_PUBLIC_FLASHY_ACCOUNT_ID=
NEXT_PUBLIC_FLASHY_LIST_WELCOME=
NEXT_PUBLIC_FLASHY_LIST_BUYERS=

# Meta Pixel
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
